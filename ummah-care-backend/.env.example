# App
APP_NAME=Ummah Care
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:44fahadhasan@localhost:5432/ummahcare?schema=public

# Cookies
COOKIE_SECRET=my_cookie_secret

# CORS
CORS_ORIGINS=http://localhost:3000,https://myapp.com

# JWT
JWT_ACCESS_SECRET=supersecretaccess
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=supersecretrefresh
JWT_REFRESH_EXPIRES_IN=30d

# Better Auth
BETTER_AUTH_SECRET=betterauthsecret
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_PATH=/api/auth/v1
BETTER_AUTH_COOKIE_PREFIX=ba
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=7d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d
BETTER_AUTH_SESSION_TOKEN_COOKIE_CACHE_AGE=300

# Google OAuth
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret

# Email / SMTP
EMAIL_SENDER_SMTP_HOST=smtp.mailtrap.io
EMAIL_SENDER_SMTP_PORT=587
EMAIL_SENDER_SMTP_USER=mailuser
EMAIL_SENDER_SMTP_PASS=mailpass
EMAIL_SENDER_SMTP_SECURE=false
EMAIL_FROM=no-reply@myapp.com